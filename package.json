    "url": "git+https://github.com/MichelNassarleb/linkedin-bot.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/MichelNassarleb/linkedin-bot/issues"
  },
  "homepage": "https://github.com/MichelNassarleb/linkedin-bot#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "playwright": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.13"
  }
